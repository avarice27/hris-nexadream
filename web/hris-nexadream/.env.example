# Database (Neon pooled connection in production; local Postgres in dev)
DATABASE_URL="postgresql://user:pass@localhost:5432/hris_nexadream"
DB_POOL_MAX="5"          # connections per serverless instance (keep small with the Neon pooler)

# Auth
JWT_SECRET=""            # long random string; REQUIRED in production
JWT_EXPIRES_IN="7d"
AUTH_SESSION_DRIVER="jwt"
SETTINGS_SECRET=""       # AES key source for secrets at rest; falls back to JWT_SECRET
HR_DATA_KEY=""           # AES key source for sensitive HR fields (D7); back it up outside the DB; ≥ 32 chars, distinct from the others
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Optional Google sign-in (button hidden when empty)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""  # redirect URI: ${SITE_URL}/api/app/auth/oauth/google/callback

# App
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
NUXT_PUBLIC_APP_ENV="development"   # 'production' switches API keys to hn_live_
NUXT_PUBLIC_SUPPORT_EMAIL="support@nexadream.id"

# Storage — public bucket (logos, avatars) + PRIVATE bucket (employee documents, signed URLs only)
STORAGE_PROVIDER="supabase"         # "supabase" | "s3" | "local" (dev only; auto-used in dev when unconfigured)
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="public"
SUPABASE_PRIVATE_BUCKET="private"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_ENDPOINT=""                     # e.g. https://<account>.r2.cloudflarestorage.com
S3_BUCKET=""                       # public bucket
S3_PRIVATE_BUCKET=""               # private bucket
S3_FORCE_PATH_STYLE="false"
S3_PUBLIC_URL_BASE=""              # CDN/public base for the public bucket

# Seed only: password for the first superadmin (dev default is used when empty)
SEED_SUPERADMIN_EMAIL="admin@nexadream.id"
SEED_SUPERADMIN_PASSWORD=""
